# ─── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Service role key — NEVER expose to browser. Used only in server-side webhook routes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1...

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the single flat-rate plan
STRIPE_STARTER_PRICE_ID=price_...

# ─── Telegram ────────────────────────────────────────────────
# Telegram bot tokens are per-tenant and stored in the `channels` table
# (channels.config.bot_token). There is no global Telegram credential.
#
# However, you must register a webhook URL with Telegram for each bot:
#   POST https://api.telegram.org/bot<BOT_TOKEN>/setWebhook
#   { "url": "https://yourdomain.com/api/webhooks/telegram?tenant=<slug>",
#     "secret_token": "<random-string>" }
#
# The secret_token goes in channels.config.webhook_secret and is used by
# /api/webhooks/telegram to verify the X-Telegram-Bot-Api-Secret-Token header.

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://pizzabot.ai
