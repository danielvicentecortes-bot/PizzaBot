# ─── Supabase ────────────────────────────────────────────────
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# Service role key — NEVER expose to browser. Used only in server-side webhook routes.
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio ──────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1...

# ─── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID for the single flat-rate plan
STRIPE_STARTER_PRICE_ID=price_...

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://pizzabot.ai
# Used to validate incoming Telegram webhook calls (optional, set per tenant in channels.config)
